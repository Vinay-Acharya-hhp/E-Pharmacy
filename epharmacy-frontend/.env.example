# Each Spring Boot microservice is called directly on its own port
# (see src/api/client.js). Override any of these if your services run
# on different hosts/ports.
#VITE_MEDICINE_URL=http://localhost:8082
#VITE_CUSTOMER_URL=http://localhost:8081
#VITE_CART_URL=http://localhost:8083
#VITE_ORDER_URL=http://localhost:8084
#VITE_PAYMENT_URL=http://localhost:8085
# For local `npm run dev` only. The Docker/k8s build (see Dockerfile)
# defaults VITE_GATEWAY_URL to the relative path "/api" instead, proxied
# by nginx to the gateway's in-cluster Service — see nginx.conf.
# This .env value is just for running the Vite dev server against a
# gateway on your own machine.
VITE_GATEWAY_URL=http://localhost:8080